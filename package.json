{
  "name": "@caasi/dom-plan",
  "version": "0.1.0",
  "description": "A lazy, monadic, jQuery-inspired layer for the DOM",
  "keywords": [
    "dom",
    "jquery",
    "lazy",
    "monad",
    "event-delegation",
    "typescript"
  ],
  "homepage": "https://github.com/caasi/dom-plan#readme",
  "bugs": {
    "url": "https://github.com/caasi/dom-plan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caasi/dom-plan.git"
  },
  "license": "MIT",
  "author": "Isaac Huang",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "AGENTS.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "e2e": "node scripts/e2e.mjs",
    "format": "prettier --write .",
    "lint": "oxlint src test examples",
    "check": "npm run typecheck && npm run lint && prettier --check . && npm test",
    "prepublishOnly": "npm run check",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "oxlint": "^1.86.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
